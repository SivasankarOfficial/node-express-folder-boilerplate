generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ProposalStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

// main user table
model User {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  password        String
  role            Role
  profile         Profile?
  jobs            Job[]      @relation("JobPostedBy")
  proposals       Proposal[] @relation("UserProposals")
  writtenReviews  Review[]   @relation("ReviewsWritten")
  receivedReviews Review[]   @relation("ReviewsReceived")
  projects        Project[]  @relation("FreelancerProjects")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now())
}

// extended profile (optional)
model Profile {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  bio          String?
  skills       String[]
  hourlyRate   Float?
  availability String?
  profileImage String?
}

// job posted by client
model Job {
  id          String     @id @default(uuid())
  title       String
  description String
  budget      Float
  category    String?
  status      JobStatus  @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  userId      String
  postedBy    User       @relation("JobPostedBy", fields: [userId], references: [id])
  proposals   Proposal[]
  project     Project?
}

// proposal submitted by freelancer
model Proposal {
  id             String         @id @default(uuid())
  content        String
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id])
  userId         String
  user           User           @relation("UserProposals", fields: [userId], references: [id])
  proposedBudget Float
  status         ProposalStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
}

// active project based on accepted proposal
model Project {
  id           String    @id @default(uuid())
  jobId        String    @unique
  job          Job       @relation(fields: [jobId], references: [id])
  freelancerId String
  status       JobStatus @default(IN_PROGRESS)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  freelancer   User      @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  review       Review?
}

// review given by client to freelancer
model Review {
  id           String   @id @default(uuid())
  rating       Int
  comment      String
  freelancer   User     @relation("ReviewsReceived", fields: [freelancerId], references: [id])
  freelancerId String
  client       User     @relation("ReviewsWritten", fields: [clientId], references: [id])
  clientId     String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id])
  projectId    String   @unique
}
